<article class="grid gap-4 rounded-xl border bg-card p-5 shadow-sm sm:grid-cols-[44px_minmax(0,1fr)]">
    <span class="grid size-9 place-items-center rounded-full bg-indigo-50 text-sm font-semibold text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-300">@Number</span>
    <div class="min-w-0">
        <h2 class="font-semibold">@Title</h2>
        <pre class="mt-3 overflow-x-auto rounded-lg bg-slate-950 p-4 text-xs leading-6 text-slate-100"><code>@Code</code></pre>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public string Number { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Code { get; set; } = string.Empty;
}
