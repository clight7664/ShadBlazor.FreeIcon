<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Layout.MainLayout)">
            <div class="mx-auto max-w-3xl px-6 py-24 text-center">
                <h1 class="text-3xl font-semibold tracking-tight">Page not found</h1>
                <a href="./" class="mt-6 inline-flex rounded-md border px-4 py-2 text-sm font-medium hover:bg-accent">Back to icons</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
