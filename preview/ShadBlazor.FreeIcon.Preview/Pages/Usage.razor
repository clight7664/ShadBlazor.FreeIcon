@page "/usage"

<PageTitle>Usage · ShadBlazor.FreeIcon</PageTitle>

<section class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-300">Getting started</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight">Use icons in Blazor</h1>
        <p class="mt-3 leading-7 text-muted-foreground">Install the package, import the namespace, then choose strongly typed or dynamic lookup depending on your UI.</p>
    </div>

    <div class="mt-8 grid gap-5">
        <UsageStep Number="1" Title="Install the NuGet package" Code="dotnet add package ShadBlazor.FreeIcon --version 1.0.0" />
        <UsageStep Number="2" Title="Import the namespace" Code="@@using ShadBlazor.FreeIcon" />
        <UsageStep Number="3" Title="Render an icon" Code="&lt;FreeIcon Icon=&quot;@@FreeIcons.Search&quot; Size=&quot;24px&quot; /&gt;&#10;&lt;FreeIcon Name=&quot;search&quot; Color=&quot;#4f46e5&quot; /&gt;" />
    </div>

    <div class="mt-8 rounded-xl border bg-card p-5 shadow-sm">
        <h2 class="font-semibold">Accessibility defaults</h2>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">Icons are decorative by default. Set <code class="rounded bg-muted px-1.5 py-0.5">Decorative="false"</code> and provide <code class="rounded bg-muted px-1.5 py-0.5">Title</code> or <code class="rounded bg-muted px-1.5 py-0.5">AriaLabel</code> when the icon carries meaning.</p>
    </div>
</section>
